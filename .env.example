# ==============================================================================
# Inquisitor Society AI Chatbot - Environment Configuration (.env.example)
# Copy this file to '.env' and fill in your real credentials.
# NEVER commit the real '.env' file to version control!
# ==============================================================================

# LLM API Keys (Optional if using Zero-Cost Local Engine)
GEMINI_API_KEY=your_gemini_api_key_here

# LLM & Embedding Settings
LLM_MODEL=gemini-1.5-flash
EMBEDDING_MODEL=tfidf-vectorizer

# RAG Parameters
TOP_K=3
SIMILARITY_THRESHOLD=0.25
CHUNK_SIZE=200
CHUNK_OVERLAP=50

# Server Settings
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
